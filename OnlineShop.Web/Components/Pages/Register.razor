@page "/register"
@using Microsoft.AspNetCore.Components.Authorization
@using OnlineShop.Web.Services
@using MudBlazor
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Регистрация</MudText>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Required="true"
                      RequiredError="Email обязателен"
                      Validation="@(new Func<string, string?>(ValidateEmail))"
                      Class="mb-3" />

        <MudTextField @bind-Value="password"
                      Label="Пароль"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      RequiredError="Пароль обязателен"
                      Validation="@(new Func<string, string?>(ValidatePassword))"
                      HelperText="Минимум 6 символов"
                      Class="mb-3" />

        <MudText Class="mb-2">Роль</MudText>
        <MudRadioGroup @bind-Value="role" Class="mb-4">
            <MudRadio Value="@("Buyer")" Color="Color.Primary">Покупатель</MudRadio>
            <MudRadio Value="@("Seller")" Color="Color.Primary">Продавец</MudRadio>
        </MudRadioGroup>

        @if (IsSeller)
        {
            <MudTextField @bind-Value="sellerDisplayName"
                          Label="Имя продавца"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Имя продавца обязательно"
                          Validation="@(new Func<string, string?>(ValidateSellerName))"
                          HelperText="Будет показано в шапке сайта"
                          Class="mb-4" />
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="HandleRegister">
            Зарегистрироваться
        </MudButton>

        <MudText Align="Align.Center" Class="mt-3">
            Уже есть аккаунт? <MudLink Href="/login">Войти</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string role = "Buyer";
    private string sellerDisplayName = string.Empty;
    private string errorMessage = string.Empty;

    private bool IsSeller => string.Equals(role, "Seller", StringComparison.OrdinalIgnoreCase);

    private string? ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email обязателен";

        // Проверка базового формата email
        var parts = email.Split('@');
        if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
            return "Введите корректный email";

        var domain = parts[1];
        if (!domain.Contains(".") || domain.StartsWith(".") || domain.EndsWith("."))
            return "Введите корректный email";

        return null;
    }

    private string? ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "Пароль обязателен";

        if (password.Length < 6)
            return "Пароль должен содержать минимум 6 символов";

        return null;
    }

    private string? ValidateSellerName(string name)
    {
        if (IsSeller && string.IsNullOrWhiteSpace(name))
            return "Имя продавца обязательно";

        if (IsSeller && name.Length < 2)
            return "Имя должно содержать минимум 2 символа";

        return null;
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        // Валидация перед отправкой
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Заполните все обязательные поля";
            return;
        }

        var emailError = ValidateEmail(email);
        if (emailError != null)
        {
            errorMessage = emailError;
            return;
        }

        var passwordError = ValidatePassword(password);
        if (passwordError != null)
        {
            errorMessage = passwordError;
            return;
        }

        if (IsSeller)
        {
            var sellerNameError = ValidateSellerName(sellerDisplayName);
            if (sellerNameError != null)
            {
                errorMessage = sellerNameError;
                return;
            }
        }

        var (result, error) = await AuthService.Register(new OnlineShop.Domain.DTOs.RegisterDto
        {
            Email = email,
            Password = password,
            Role = role,
            SellerDisplayName = IsSeller ? sellerDisplayName.Trim() : null
        });

        if (result == null)
        {
            errorMessage = error ?? "Ошибка регистрации. Возможно, этот email уже используется";
            return;
        }

        await AuthService.SaveToken(result.Token);
        await ((CustomAuthStateProvider)AuthStateProvider).NotifyAuthStateChanged();
        Navigation.NavigateTo("/");
    }
}
