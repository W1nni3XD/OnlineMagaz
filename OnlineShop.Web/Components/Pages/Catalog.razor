@page "/catalog"
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using OnlineShop.Web.Services
@using OnlineShop.Domain.DTOs
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject CartService CartService
@inject WishlistService WishlistService
@inject CartSidebarState CartSidebarState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="searchQuery"
                          Label="Поиск товаров"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @onkeyup="HandleSearch" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="selectedCategory"
                       Label="Категория"
                       Variant="Variant.Outlined"
                       @bind-Value:after="LoadProducts">
                <MudSelectItem Value="0">Все категории</MudSelectItem>
                @foreach (var cat in categories)
                {
                    <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudNumericField @bind-Value="minPrice"
                             Label="Цена от"
                             Variant="Variant.Outlined"
                             Min="0"
                             Format="N0"
                             @bind-Value:after="LoadProducts" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudNumericField @bind-Value="maxPrice"
                             Label="Цена до"
                             Variant="Variant.Outlined"
                             Min="0"
                             Format="N0"
                             @bind-Value:after="LoadProducts" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudCheckBox @bind-Value="onlyInStock"
                         Label="Только в наличии"
                         Color="Color.Primary"
                         @bind-Value:after="LoadProducts" />
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (!products.Any())
    {
        <MudAlert Severity="Severity.Info">Товары не найдены</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var product in products)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2" Style="border-radius: 12px; height: 100%; position: relative;">

                        <!-- Кнопка избранного -->
                        <MudIconButton Icon="@(wishlistIds.Contains(product.Id) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                       Color="@(wishlistIds.Contains(product.Id) ? Color.Error : Color.Default)"
                                       Size="Size.Small"
                                       Style="position: absolute; top: 8px; right: 8px; z-index: 1; background: white; border-radius: 50%;"
                                       OnClick="() => ToggleWishlist(product.Id)"
                                       Title="@(wishlistIds.Contains(product.Id) ? "Убрать из избранного" : "В избранное")" />

                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <MudCardMedia Image="@ImageUrlNormalizer.Normalize(product.ImageUrl)" Height="200" />
                        }
                        else
                        {
                            <div style="height: 200px; background: #f5f5f5; display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size: 4rem; color: #ccc;" />
                            </div>
                        }
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">@product.Name</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-1">@product.CategoryName</MudChip>
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">
                                @product.Price.ToString("C")
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick='() => Navigation.NavigateTo($"/product/{product.Id}")'>
                                Подробнее
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       OnClick="() => AddToCart(product.Id)">
                                В корзину
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudPagination Class="mt-4"
                       Count="@totalPages"
                       Selected="@currentPage"
                       SelectedChanged="@OnPageChanged"
                       Color="Color.Primary"
                       ShowFirstButton="true"
                       ShowLastButton="true" />
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }

    private List<ProductDto> products = new();
    private List<CategoryDto> categories = new();
    private HashSet<int> wishlistIds = new();
    private string searchQuery = string.Empty;
    private int selectedCategory = 0;
    private decimal? minPrice = null;
    private decimal? maxPrice = null;
    private bool onlyInStock = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int pageSize = 12;
    private bool isLoading = true;
    private bool initialized = false;
    private bool disposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            try
            {
                categories = await CategoryService.GetAll();
                if (CategoryId.HasValue)
                    selectedCategory = CategoryId.Value;

                await LoadProducts();

                // Загружаем избранное (если не авторизован — просто пустой список)
                try
                {
                    var wishlist = await WishlistService.GetWishlist();
                    wishlistIds = wishlist.Select(w => w.ProductId).ToHashSet();
                }
                catch { }
            }
            catch { }

            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProducts()
    {
        if (disposed) return;
        isLoading = true;
        var result = await ProductService.GetAll(
            selectedCategory == 0 ? null : selectedCategory,
            string.IsNullOrEmpty(searchQuery) ? null : searchQuery,
            minPrice,
            maxPrice,
            onlyInStock ? true : null,
            currentPage,
            pageSize
        );
        products = result.Products;
        totalPages = result.TotalPages;
        isLoading = false;
    }

    private async Task ToggleWishlist(int productId)
    {
        if (disposed) return;
        if (wishlistIds.Contains(productId))
        {
            await WishlistService.RemoveByProductId(productId);
            wishlistIds.Remove(productId);
        }
        else
        {
            var (success, _) = await WishlistService.AddToWishlist(productId);
            if (success)
                wishlistIds.Add(productId);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPageChanged(int page)
    {
        if (disposed) return;
        currentPage = page;
        await LoadProducts();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearch()
    {
        if (disposed) return;
        await LoadProducts();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task AddToCart(int productId)
    {
        if (disposed) return;

        if (!await IsAuthenticated())
        {
            Snackbar.Add("Вы должны войти в аккаунт!", Severity.Warning);
            return;
        }

        var isAdded = await CartService.AddToCart(new OnlineShop.Domain.DTOs.AddToCartDto
        {
            ProductId = productId,
            Quantity = 1
        });
        if (isAdded)
            CartSidebarState.Open();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> IsAuthenticated()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated == true;
    }

    public void Dispose()
    {
        disposed = true;
    }
}