@page "/catalog"
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using OnlineShop.Web.Services
@using OnlineShop.Domain.DTOs
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject CartService CartService
@inject WishlistService WishlistService
@inject CartSidebarState CartSidebarState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@implements IDisposable

<MudText Typo="Typo.h4" Class="page-title mb-4">Каталог</MudText>

<MudPaper Elevation="0" Class="filters-panel mb-5">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="searchQuery"
                          Label="Поиск товаров"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @onkeyup="HandleSearch" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="selectedCategory"
                       Label="Категория"
                       Variant="Variant.Outlined"
                       @bind-Value:after="LoadProducts">
                <MudSelectItem Value="0">Все категории</MudSelectItem>
                @foreach (var cat in categories)
                {
                    <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField @bind-Value="minPrice"
                             Label="Цена от"
                             Variant="Variant.Outlined"
                             Min="0"
                             Format="N0"
                             @bind-Value:after="LoadProducts" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField @bind-Value="maxPrice"
                             Label="Цена до"
                             Variant="Variant.Outlined"
                             Min="0"
                             Format="N0"
                             @bind-Value:after="LoadProducts" />
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudCheckBox @bind-Value="onlyInStock"
                         Label="В наличии"
                         Color="Color.Primary"
                         @bind-Value:after="LoadProducts" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!products.Any())
{
    <MudAlert Severity="Severity.Info" Class="empty-state">Товары не найдены — попробуйте изменить фильтры.</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        @foreach (var product in products)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0" Class="product-card">

                    <MudIconButton Icon="@(wishlistIds.Contains(product.Id) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                   Color="@(wishlistIds.Contains(product.Id) ? Color.Error : Color.Default)"
                                   Size="Size.Small"
                                   Class="wishlist-btn"
                                   OnClick="() => ToggleWishlist(product.Id)"
                                   Title="@(wishlistIds.Contains(product.Id) ? "Убрать из избранного" : "В избранное")" />

                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <MudCardMedia Image="@ImageUrlNormalizer.Normalize(product.ImageUrl)" Height="200" Class="product-media" />
                    }
                    else
                    {
                        <div class="product-media-placeholder">
                            <MudIcon Icon="@Icons.Material.Filled.Image" />
                        </div>
                    }
                    <MudCardContent Class="pb-0">
                        <MudText Typo="Typo.subtitle1" Class="product-name">@product.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Class="category-chip">@product.CategoryName</MudChip>
                        <MudText Typo="Typo.h6" Class="product-price mt-2">
                            @product.Price.ToString("C")
                        </MudText>
                    </MudCardContent>
                    <MudCardActions Class="px-4 pb-4">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick='() => Navigation.NavigateTo($"/product/{product.Id}")'>
                            Подробнее
                        </MudButton>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Outlined.ShoppingCart"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       OnClick="() => AddToCart(product.Id)"
                                       Title="В корзину" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudPagination Class="mt-6 d-flex justify-center"
                   Count="@totalPages"
                   Selected="@currentPage"
                   SelectedChanged="@OnPageChanged"
                   Color="Color.Primary"
                   ShowFirstButton="true"
                   ShowLastButton="true" />
}

@code {
    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }

    private List<ProductDto> products = new();
    private List<CategoryDto> categories = new();
    private HashSet<int> wishlistIds = new();
    private string searchQuery = string.Empty;
    private int selectedCategory = 0;
    private decimal? minPrice = null;
    private decimal? maxPrice = null;
    private bool onlyInStock = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int pageSize = 12;
    private bool isLoading = true;
    private bool initialized = false;
    private bool disposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            try
            {
                categories = await CategoryService.GetAll();
                if (CategoryId.HasValue)
                    selectedCategory = CategoryId.Value;

                await LoadProducts();

                try
                {
                    var wishlist = await WishlistService.GetWishlist();
                    wishlistIds = wishlist.Select(w => w.ProductId).ToHashSet();
                }
                catch { }
            }
            catch { }

            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProducts()
    {
        if (disposed) return;
        isLoading = true;
        var result = await ProductService.GetAll(
            selectedCategory == 0 ? null : selectedCategory,
            string.IsNullOrEmpty(searchQuery) ? null : searchQuery,
            minPrice,
            maxPrice,
            onlyInStock ? true : null,
            currentPage,
            pageSize
        );
        products = result.Products;
        totalPages = result.TotalPages;
        isLoading = false;
    }

    private async Task ToggleWishlist(int productId)
    {
        if (disposed) return;
        if (wishlistIds.Contains(productId))
        {
            await WishlistService.RemoveByProductId(productId);
            wishlistIds.Remove(productId);
        }
        else
        {
            var (success, _) = await WishlistService.AddToWishlist(productId);
            if (success)
                wishlistIds.Add(productId);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPageChanged(int page)
    {
        if (disposed) return;
        currentPage = page;
        await LoadProducts();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearch()
    {
        if (disposed) return;
        await LoadProducts();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task AddToCart(int productId)
    {
        if (disposed) return;

        if (!await IsAuthenticated())
        {
            Snackbar.Add("Вы должны войти в аккаунт!", Severity.Warning);
            return;
        }

        var isAdded = await CartService.AddToCart(new OnlineShop.Domain.DTOs.AddToCartDto
        {
            ProductId = productId,
            Quantity = 1
        });
        if (isAdded)
            CartSidebarState.Open();
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> IsAuthenticated()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated == true;
    }

    public void Dispose()
    {
        disposed = true;
    }
}
