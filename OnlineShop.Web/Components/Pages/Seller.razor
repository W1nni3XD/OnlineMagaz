@page "/seller"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Seller,Admin")]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using OnlineShop.Domain.DTOs
@using OnlineShop.Web.Services
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudText Typo="Typo.h5" Class="mb-4">Мои товары</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle1" Class="mb-3">
        @(editingId == null ? "Новый товар" : "Редактирование товара")
    </MudText>

    @if (!categories.Any())
    {
        <MudAlert Severity="Severity.Info">
            Категории создаются администратором. Обратитесь к админу для добавления нужной категории.
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="form.Name"
                              Label="Название"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Название обязательно"
                              Validation="@(new Func<string, string?>(ValidateProductName))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int"
                           @bind-Value="form.CategoryId"
                           Label="Категория"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var c in categories)
                    {
                        <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="form.Description"
                              Label="Описание"
                              Variant="Variant.Outlined"
                              Lines="3" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="form.Price"
                                 Label="Цена"
                                 Variant="Variant.Outlined"
                                 Min="0.01m"
                                 Required="true"
                                 RequiredError="Цена обязательна"
                                 Format="N2"
                                 Culture="@System.Globalization.CultureInfo.GetCultureInfo("ru-RU")"
                                 HelperText="Должна быть больше 0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="form.Stock"
                                 Label="Остаток на складе"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Required="true"
                                 RequiredError="Остаток обязателен"
                                 Step="1"
                                 HelperText="Не может быть отрицательным" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mb-2">Изображение товара</MudText>
                <input id="imageFileInput" type="file" accept="image/*" style="display:none" />
                <MudButton Variant="Variant.Outlined"
                           Disabled="uploadingImage"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="PickAndUploadImage">
                    @(uploadingImage ? "Загрузка..." : "Выбрать картинку")
                </MudButton>
                @if (!string.IsNullOrEmpty(imageUrlBind))
                {
                    <MudText Typo="Typo.caption" Class="mt-1" Color="Color.Success">✓ Картинка загружена</MudText>
                    <img src="@imageUrlBind" style="max-height:80px; margin-top:8px; display:block;" />
                }
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveAsync"
                           Disabled="busy">
                    @(editingId == null ? "Добавить товар" : "Сохранить")
                </MudButton>
                @if (editingId != null)
                {
                    <MudButton Variant="Variant.Text"
                               Class="ml-2"
                               OnClick="CancelEdit"
                               Disabled="busy">
                        Отмена
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!myProducts.Any())
{
    <MudAlert Severity="Severity.Info">У вас пока нет товаров — добавьте первый через форму выше.</MudAlert>
}
else
{
    <MudTable Items="@myProducts" Hover="true" Breakpoint="Breakpoint.Md">
        <HeaderContent>
            <MudTh>Название</MudTh>
            <MudTh>Категория</MudTh>
            <MudTh Class="text-end">Цена</MudTh>
            <MudTh Class="text-end">Остаток</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Название">@context.Name</MudTd>
            <MudTd DataLabel="Категория">@context.CategoryName</MudTd>
            <MudTd DataLabel="Цена" Class="text-end">@context.Price.ToString("C")</MudTd>
            <MudTd DataLabel="Остаток" Class="text-end">@context.Stock</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => StartEdit(context)">
                    Изменить
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteProductAsync(context.Id)">
                    Удалить
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private readonly List<ProductDto> myProducts = new();
    private List<CategoryDto> categories = new();
    private CreateProductDto form = new();
    private string imageUrlBind = string.Empty;
    private int? editingId;
    private bool isLoading = true;
    private bool busy;
    private bool uploadingImage;
    private bool disposed;
    private DotNetObjectReference<Seller>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await ReloadCategoriesAndProductsAsync();
    }

    [JSInvokable]
    public async Task OnImageUploaded(string? url)
    {
        uploadingImage = false;
        if (url != null)
        {
            imageUrlBind = url;
            Snackbar.Add("Картинка загружена", Severity.Success);
        }
        else
        {
            Snackbar.Add("Ошибка загрузки картинки", Severity.Error);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task PickAndUploadImage()
    {
        uploadingImage = true;
        StateHasChanged();
        var token = await AuthService.GetToken();
        await JSRuntime.InvokeVoidAsync("openFileAndUpload", "imageFileInput", token, "http://localhost:5170/", _dotNetRef);
    }

    private async Task ReloadCategoriesAndProductsAsync()
    {
        isLoading = true;
        try
        {
            categories = await CategoryService.GetAvailableForSeller();
            if (categories.Any() && (form.CategoryId == 0 || !categories.Any(c => c.Id == form.CategoryId)))
                form.CategoryId = categories[0].Id;

            myProducts.Clear();
            myProducts.AddRange(await ProductService.GetMine());
        }
        catch
        {
            Snackbar.Add("Не удалось загрузить данные. Проверьте вход и API.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(ProductDto p)
    {
        editingId = p.Id;
        form = new CreateProductDto
        {
            Name = p.Name,
            Description = p.Description,
            Price = p.Price,
            Stock = p.Stock,
            CategoryId = p.CategoryId,
            ImageUrl = string.IsNullOrEmpty(p.ImageUrl) ? null : p.ImageUrl
        };
        imageUrlBind = p.ImageUrl ?? string.Empty;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new CreateProductDto();
        imageUrlBind = string.Empty;
        if (categories.Any())
            form.CategoryId = categories[0].Id;
    }

    private string? ValidateProductName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "Название обязательно";
        if (name.Length < 3)
            return "Название должно содержать минимум 3 символа";
        if (name.Length > 200)
            return "Название слишком длинное (максимум 200 символов)";
        return null;
    }

    private async Task SaveAsync()
    {
        if (disposed) return;

        var nameError = ValidateProductName(form.Name);
        if (nameError != null)
        {
            Snackbar.Add(nameError, Severity.Warning);
            return;
        }

        if (!categories.Any() || form.CategoryId == 0)
        {
            Snackbar.Add("Выберите категорию", Severity.Warning);
            return;
        }

        if (form.Price <= 0)
        {
            Snackbar.Add("Цена должна быть больше 0", Severity.Warning);
            return;
        }

        if (form.Stock < 0)
        {
            Snackbar.Add("Остаток не может быть отрицательным", Severity.Warning);
            return;
        }

        form.ImageUrl = string.IsNullOrWhiteSpace(imageUrlBind) ? null : imageUrlBind.Trim();

        busy = true;
        try
        {
            bool ok;
            if (editingId == null)
                ok = await ProductService.Create(form);
            else
                ok = await ProductService.Update(editingId.Value, form);

            if (ok)
            {
                Snackbar.Add(editingId == null ? "Товар добавлен" : "Изменения сохранены", Severity.Success);
                CancelEdit();
                await ReloadCategoriesAndProductsAsync();
            }
            else
                Snackbar.Add("Ошибка сохранения. Попробуйте снова (нужен вход как продавец).", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteProductAsync(int id)
    {
        if (disposed) return;
        busy = true;
        try
        {
            var ok = await ProductService.Delete(id);
            if (ok)
            {
                Snackbar.Add("Товар удалён", Severity.Info);
                if (editingId == id)
                    CancelEdit();
                await ReloadCategoriesAndProductsAsync();
            }
            else
                Snackbar.Add("Не удалось удалить", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        disposed = true;
        _dotNetRef?.Dispose();
    }
}