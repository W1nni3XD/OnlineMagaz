@page "/login"
@inject OnlineShop.Web.Services.AuthService AuthService
@inject OnlineShop.Web.Services.CustomAuthStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using OnlineShop.Web.Services
@using MudBlazor
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Вход</MudText>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Required="true"
                      RequiredError="Email обязателен"
                      Validation="@(new Func<string, string?>(ValidateEmail))"
                      Class="mb-3" />

        <MudTextField @bind-Value="password"
                      Label="Пароль"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      RequiredError="Пароль обязателен"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="HandleLogin">
            Войти
        </MudButton>

        <MudText Align="Align.Center" Class="mt-3">
            Нет аккаунта? <MudLink Href="/register">Зарегистрироваться</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private string? ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email обязателен";

        // Проверка базового формата email
        var parts = email.Split('@');
        if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
            return "Введите корректный email";

        var domain = parts[1];
        if (!domain.Contains(".") || domain.StartsWith(".") || domain.EndsWith("."))
            return "Введите корректный email";

        return null;
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        // Валидация перед отправкой
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Заполните все поля";
            return;
        }

        var emailError = ValidateEmail(email);
        if (emailError != null)
        {
            errorMessage = emailError;
            return;
        }

        var (result, error) = await AuthService.Login(new OnlineShop.Domain.DTOs.LoginDto
        {
            Email = email,
            Password = password
        });

        if (result == null)
        {
            errorMessage = error ?? "Неверный email или пароль";
            return;
        }

        await AuthService.SaveToken(result.Token);
        await ((CustomAuthStateProvider)AuthStateProvider).NotifyAuthStateChanged();
        Navigation.NavigateTo("/");
    }
}