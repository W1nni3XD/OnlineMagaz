@page "/wishlist"
@using MudBlazor
@using OnlineShop.Web.Services
@using OnlineShop.Domain.DTOs
@inject WishlistService WishlistService
@inject CartService CartService
@inject CartSidebarState CartSidebarState
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">
        <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" Class="mr-2" />
        Избранное
    </MudText>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (!items.Any())
    {
        <MudPaper Class="pa-8" Elevation="0" Style="text-align: center; border: 2px dashed #e0e0e0; border-radius: 16px;">
            <MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder"
                     Style="font-size: 5rem; color: #bdbdbd;" />
            <MudText Typo="Typo.h6" Class="mt-3" Style="color: #9e9e9e;">
                Список избранного пуст
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: #bdbdbd;">
                Добавляйте товары в избранное, нажав на ❤️ в каталоге
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Store"
                       OnClick='() => Navigation.NavigateTo("/catalog")'>
                Перейти в каталог
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-3" Style="color: #757575;">
            @items.Count @PluralItems(items.Count)
        </MudText>

        <MudGrid>
            @foreach (var item in items)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2" Style="border-radius: 12px; height: 100%; position: relative;">

                        <MudIconButton Icon="@Icons.Material.Filled.Favorite"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Style="position: absolute; top: 8px; right: 8px; z-index: 1; background: white; border-radius: 50%;"
                                       OnClick="() => RemoveFromWishlist(item.Id)"
                                       Title="Убрать из избранного" />

                        @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                        {
                            <MudCardMedia Image="@ImageUrlNormalizer.Normalize(item.ProductImageUrl)" Height="200" />
                        }
                        else
                        {
                            <div style="height: 200px; background: #f5f5f5; display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size: 4rem; color: #ccc;" />
                            </div>
                        }

                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">@item.ProductName</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-1">
                                @item.CategoryName
                            </MudChip>
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">
                                @item.ProductPrice.ToString("C")
                            </MudText>
                            @if (item.ProductStock == 0)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="mt-1">
                                    Нет в наличии
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-1">
                                    В наличии: @item.ProductStock
                                </MudChip>
                            }
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick='() => Navigation.NavigateTo($"/product/{item.ProductId}")'>
                                Подробнее
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       Disabled="@(item.ProductStock == 0)"
                                       OnClick="() => AddToCart(item.ProductId)">
                                В корзину
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<WishlistItemDto> items = new();
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadWishlist();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadWishlist()
    {
        isLoading = true;
        items = await WishlistService.GetWishlist();
        isLoading = false;
    }

    private async Task RemoveFromWishlist(int id)
    {
        await WishlistService.RemoveFromWishlist(id);
        items.RemoveAll(i => i.Id == id);
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddToCart(int productId)
    {
        var isAdded = await CartService.AddToCart(new AddToCartDto
        {
            ProductId = productId,
            Quantity = 1
        });
        if (isAdded)
            CartSidebarState.Open();
        await InvokeAsync(StateHasChanged);
    }

    private string PluralItems(int count) => count switch
    {
        1 => "товар",
        >= 2 and <= 4 => "товара",
        _ => "товаров"
    };
}