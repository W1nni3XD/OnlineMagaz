@inherits LayoutComponentBase
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using OnlineShop.Web.Services
@inject CartSidebarState CartSidebarState
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <div class="brand">
            <MudIcon Icon="@Icons.Material.Filled.Storefront" Class="brand-icon" />
            <MudText Typo="Typo.h6" Class="brand-text">OnlineShop</MudText>
        </div>

        <nav class="top-nav d-none d-md-flex">
            <MudNavLink Href="" Match="NavLinkMatch.All">Главная</MudNavLink>
            <MudNavLink Href="catalog">Каталог</MudNavLink>
            <AuthorizeView Context="navAuth">
                <Authorized>
                    <MudNavLink Href="orders">Мои заказы</MudNavLink>
                    <AuthorizeView Roles="Buyer,Seller,Admin" Context="wishlistAuth">
                        <MudNavLink Href="wishlist">Избранное</MudNavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="Seller,Admin" Context="sellerAuth">
                        <MudNavLink Href="seller">Мои товары</MudNavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin" Context="adminAuth">
                        <MudNavLink Href="admin">Админ панель</MudNavLink>
                    </AuthorizeView>
                </Authorized>
            </AuthorizeView>
        </nav>

        <MudSpacer />

        <AuthorizeView Context="headerAuth">
            <Authorized>
                <MudButton Href="profile" Variant="Variant.Text" Color="Color.Inherit" Class="profile-link d-none d-sm-flex">
                    @(GetProfileLabel(headerAuth.User))
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Outlined.ShoppingCart"
                               Color="Color.Inherit"
                               OnClick="OpenCart"
                               aria-label="Открыть корзину" />
                <MudButton Href="/logout" Variant="Variant.Outlined" Color="Color.Inherit" Class="ml-2">
                    Выйти
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit">Войти</MudButton>
                <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                    Регистрация
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Class="d-md-none ml-1"
                       OnClick="ToggleMobileMenu"
                       aria-label="Меню" />
    </MudAppBar>

    @if (mobileMenuOpen)
    {
        <div class="mobile-nav d-md-none">
            <MudNavMenu>
                <MudNavLink Href="" Match="NavLinkMatch.All" OnClick="CloseMobileMenu">Главная</MudNavLink>
                <MudNavLink Href="catalog" OnClick="CloseMobileMenu">Каталог</MudNavLink>
                <AuthorizeView Context="mobileAuth">
                    <Authorized>
                        <MudNavLink Href="profile" OnClick="CloseMobileMenu">Профиль</MudNavLink>
                        <MudNavLink Href="orders" OnClick="CloseMobileMenu">Мои заказы</MudNavLink>
                        <AuthorizeView Roles="Buyer,Seller,Admin" Context="wishlistAuthMobile">
                            <MudNavLink Href="wishlist" OnClick="CloseMobileMenu">Избранное</MudNavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="Seller,Admin" Context="sellerAuthMobile">
                            <MudNavLink Href="seller" OnClick="CloseMobileMenu">Мои товары</MudNavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin" Context="adminAuthMobile">
                            <MudNavLink Href="admin" OnClick="CloseMobileMenu">Админ панель</MudNavLink>
                        </AuthorizeView>
                    </Authorized>
                </AuthorizeView>
            </MudNavMenu>
        </div>
    }

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>

    <CartSidebar @bind-IsOpen="CartOpen" />
</MudLayout>

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

@code {
    private bool cartOpen = false;
    private bool mobileMenuOpen = false;
    private Timer? _sessionTimer;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1F2D3D",
            Secondary = "#D98E4A",
            AppbarBackground = "#1F2D3D",
            Background = "#F7F5F2",
            Surface = "#FFFFFF"
        }
    };

    private bool CartOpen
    {
        get => cartOpen;
        set
        {
            if (cartOpen == value) return;
            cartOpen = value;
            CartSidebarState.Set(value);
        }
    }

    protected override void OnInitialized()
    {
        cartOpen = CartSidebarState.IsOpen;
        CartSidebarState.OnChange += HandleCartSidebarStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _sessionTimer = new Timer(async _ =>
        {
            var token = await AuthService.GetToken();
            if (string.IsNullOrEmpty(token)) return;

            try
            {
                var payload = token.Split('.')[1];
                switch (payload.Length % 4)
                {
                    case 2: payload += "=="; break;
                    case 3: payload += "="; break;
                }
                var json = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(
                    Convert.FromBase64String(payload));

                if (json != null && json.TryGetValue("exp", out var expObj) &&
                    long.TryParse(expObj.ToString(), out var exp))
                {
                    var expDate = DateTimeOffset.FromUnixTimeSeconds(exp).UtcDateTime;
                    if (expDate < DateTime.UtcNow)
                    {
                        await AuthService.RemoveToken();
                        await InvokeAsync(async () =>
                        {
                            if (AuthenticationStateProvider is CustomAuthStateProvider provider)
                                await provider.NotifyAuthStateChanged();

                            Snackbar.Add("Сессия истекла. Пожалуйста, войдите снова.", Severity.Warning);
                            Navigation.NavigateTo("/login", forceLoad: true);
                        });
                    }
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;

    private void OpenCart() => CartSidebarState.Open();

    private void HandleCartSidebarStateChanged()
    {
        cartOpen = CartSidebarState.IsOpen;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartSidebarState.OnChange -= HandleCartSidebarStateChanged;
        _sessionTimer?.Dispose();
    }

    private static string GetProfileLabel(ClaimsPrincipal user)
    {
        return user.FindFirst("profile_display")?.Value
               ?? user.FindFirst(ClaimTypes.Email)?.Value
               ?? string.Empty;
    }
}
